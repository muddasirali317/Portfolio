<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Spatial and temporal research outputs for the 2013 Mw 7.7 Awaran earthquake precursor analysis.">
  <title>Awaran Earthquake Research — Muddasir Ali</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#06100c;--panel:#0b1913;--panel2:#0e2018;--jade:#52b788;--mint:#95d5b2;--gold:#e8b84b;--white:#f5f2e9;--muted:#91a49a;--line:#74c69d27;--serif:"DM Serif Display",serif;--sans:Inter,sans-serif;--mono:"JetBrains Mono",monospace;--ease:cubic-bezier(.16,1,.3,1)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--ink);color:var(--white);font-family:var(--sans);overflow-x:hidden}body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 85% 5%,#52b78818,transparent 28%),radial-gradient(circle at 10% 65%,#e8b84b0b,transparent 24%),linear-gradient(#ffffff04 1px,transparent 1px),linear-gradient(90deg,#ffffff04 1px,transparent 1px);background-size:auto,auto,52px 52px,52px 52px;z-index:-1}
    a{color:inherit;text-decoration:none}.wrap{width:min(1240px,calc(100% - 42px));margin:auto}.topbar{position:sticky;top:0;z-index:20;background:#06100cdd;backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}.topbar .wrap{height:72px;display:flex;align-items:center;justify-content:space-between}.back,.index{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase}.back{color:var(--mint);transition:color .25s}.back:hover{color:var(--white)}.index{color:#91a49a88}
    .hero{min-height:72vh;display:flex;align-items:end;padding:90px 0 76px;border-bottom:1px solid var(--line);position:relative;overflow:hidden}.hero:after{content:"Mw 7.7";position:absolute;right:-.04em;bottom:-.23em;font-family:var(--serif);font-size:clamp(130px,25vw,380px);color:#ffffff03;line-height:1;pointer-events:none}.eyebrow,.section-kicker{font-family:var(--mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--jade)}h1{font-family:var(--serif);font-weight:400;font-size:clamp(54px,8.5vw,126px);letter-spacing:-.045em;line-height:.87;max-width:1050px;margin:24px 0 34px}h1 em{color:var(--gold);font-weight:400}.lead{max-width:730px;font-size:clamp(15px,1.6vw,20px);font-weight:300;line-height:1.72;color:#b7c4bd}.facts{display:flex;flex-wrap:wrap;gap:8px;margin-top:34px}.fact{padding:10px 13px;border:1px solid var(--line);border-radius:999px;font-family:var(--mono);font-size:9px;letter-spacing:.09em;color:var(--mint);background:#52b78808}
    section{padding:104px 0;border-bottom:1px solid var(--line)}.section-head{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end;margin-bottom:44px}.section-head h2{font-family:var(--serif);font-weight:400;font-size:clamp(38px,5vw,70px);line-height:.96;margin:13px 0 0;letter-spacing:-.035em}.section-head p{margin:0;color:var(--muted);font-size:14px;line-height:1.75;max-width:530px;justify-self:end}
    .gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.card{margin:0;background:linear-gradient(145deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:18px;overflow:hidden;opacity:0;transform:translateY(30px);transition:opacity .8s var(--ease),transform .8s var(--ease),border-color .35s}.card.visible{opacity:1;transform:none}.card:hover{border-color:#52b78865}.card.featured{grid-column:1/-1}.image-shell{height:430px;padding:9px;background:#07100d;overflow:hidden}.card.featured .image-shell{height:auto;max-height:none}.image-shell img{width:100%;height:100%;display:block;object-fit:contain;background:#f4f0df;transition:transform .7s var(--ease),filter .5s}.card.featured .image-shell img{height:auto}.card:hover img{transform:scale(1.012);filter:contrast(1.02)}figcaption{display:flex;justify-content:space-between;gap:22px;align-items:center;padding:18px 20px}figcaption strong{font-family:var(--serif);font-size:20px;font-weight:400}figcaption span{font-family:var(--mono);font-size:8px;text-transform:uppercase;letter-spacing:.12em;color:var(--jade);white-space:nowrap}.note{margin-top:22px;color:#91a49a88;font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase}
    footer{padding:54px 0}.footer-inner{display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:12px}.footer-inner a{font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--mint)}
    @media(max-width:760px){.wrap{width:min(100% - 26px,1240px)}.hero{min-height:64vh;padding:64px 0 54px}.section-head{grid-template-columns:1fr}.section-head p{justify-self:start}.gallery{grid-template-columns:1fr}.card.featured{grid-column:auto}.image-shell{height:310px}section{padding:76px 0}figcaption{align-items:flex-start;flex-direction:column;gap:6px}.index{display:none}.footer-inner{align-items:flex-start;flex-direction:column;gap:16px}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.card{opacity:1;transform:none;transition:none}.image-shell img{transition:none}}
  </style>
</head>
<body>
  <header class="topbar"><div class="wrap"><a class="back" href="muddasir-portfolio-fused.html#projects">← Back to portfolio</a><span class="index">Research archive · 23 outputs</span></div></header>
  <main>
    <div class="hero"><div class="wrap"><div class="eyebrow">Case study · Awaran District · Balochistan</div><h1>Reading signals before an <em>earthquake.</em></h1><p class="lead">A spatial and temporal investigation of potential atmospheric and land-surface precursors surrounding the Mw 7.7 Awaran earthquake of 24 September 2013.</p><div class="facts"><span class="fact">5 precursor variables</span><span class="fact">3 detection approaches</span><span class="fact">Jun–Oct 2013</span><span class="fact">Satellite + reanalysis data</span></div></div></div>

    <section><div class="wrap"><div class="section-head"><div><div class="section-kicker">01 · Spatial evidence</div><h2>Study area &amp; anomaly maps</h2></div><p>The mapping sequence establishes the district, fault relationship, epicentre, and pre-seismic spatial behaviour of air temperature, dew point, OLR, AOD, and land-surface temperature.</p></div><div class="gallery">
      <figure class="card featured"><a class="image-shell" href="assets/awara-results/study-area.jpg" target="_blank"><img src="assets/awara-results/study-area.jpg" alt="Awaran district study area, fault line and Mw 7.7 epicentre"></a><figcaption><strong>Awaran study area</strong><span>Regional context ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/air-temperature-map.jpg" target="_blank"><img loading="lazy" src="assets/awara-results/air-temperature-map.jpg" alt="Pre-seismic air temperature anomaly map"></a><figcaption><strong>Air temperature</strong><span>Spatial anomaly ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/dew-point-map.jpg" target="_blank"><img loading="lazy" src="assets/awara-results/dew-point-map.jpg" alt="Pre-seismic dew point temperature anomaly map"></a><figcaption><strong>Dew point temperature</strong><span>Spatial anomaly ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/olr-map.jpg" target="_blank"><img loading="lazy" src="assets/awara-results/olr-map.jpg" alt="Pre-seismic outgoing longwave radiation map"></a><figcaption><strong>Outgoing longwave radiation</strong><span>Spatial anomaly ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/aod-anomaly-map.jpg" target="_blank"><img loading="lazy" src="assets/awara-results/aod-anomaly-map.jpg" alt="Pre-seismic aerosol optical depth map"></a><figcaption><strong>Aerosol optical depth</strong><span>Spatial anomaly ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/lst-preeq-map.jpg" target="_blank"><img loading="lazy" src="assets/awara-results/lst-preeq-map.jpg" alt="Pre-earthquake land surface temperature map"></a><figcaption><strong>Land surface temperature</strong><span>Pre-EQ surface ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/lst-anomaly-map.jpg" target="_blank"><img loading="lazy" src="assets/awara-results/lst-anomaly-map.jpg" alt="Land surface temperature deviation above baseline"></a><figcaption><strong>LST deviation</strong><span>Above baseline ↗</span></figcaption></figure>
    </div><div class="note">Select any figure to inspect its full-resolution layout</div></div></section>

    <section><div class="wrap"><div class="section-head"><div><div class="section-kicker">02 · Temporal behaviour</div><h2>Daily time series</h2></div><p>Daily observations show how each precursor evolved through the months surrounding the event and provide the baseline for later anomaly tests.</p></div><div class="gallery">
      <figure class="card"><a class="image-shell" href="assets/awara-results/daily-airtemp.png" target="_blank"><img loading="lazy" src="assets/awara-results/daily-airtemp.png" alt="Daily air temperature time series"></a><figcaption><strong>Daily air temperature</strong><span>Jun–Oct 2013 ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/daily-dew-point.png" target="_blank"><img loading="lazy" src="assets/awara-results/daily-dew-point.png" alt="Daily dew point time series"></a><figcaption><strong>Daily dew point</strong><span>Jun–Oct 2013 ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/daily-mean-lst.png" target="_blank"><img loading="lazy" src="assets/awara-results/daily-mean-lst.png" alt="Daily mean land surface temperature"></a><figcaption><strong>Daily mean LST</strong><span>Jun–Oct 2013 ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/daily-olr.png" target="_blank"><img loading="lazy" src="assets/awara-results/daily-olr.png" alt="Daily outgoing longwave radiation"></a><figcaption><strong>Daily OLR</strong><span>Jun–Oct 2013 ↗</span></figcaption></figure>
      <figure class="card featured"><a class="image-shell" href="assets/awara-results/daily-aod.png" target="_blank"><img loading="lazy" src="assets/awara-results/daily-aod.png" alt="Daily aerosol optical depth"></a><figcaption><strong>Daily aerosol optical depth</strong><span>Jun–Oct 2013 ↗</span></figcaption></figure>
    </div></div></section>

    <section><div class="wrap"><div class="section-head"><div><div class="section-kicker">03 · Model comparison</div><h2>Three anomaly detectors</h2></div><p>Each variable was evaluated using a mean ±2σ threshold, Isolation Forest, and ARIMA residual analysis—placing conventional statistics, machine learning, and time-series modelling side by side.</p></div><div class="gallery">
      <figure class="card"><a class="image-shell" href="assets/awara-results/airtemp-models.png" target="_blank"><img loading="lazy" src="assets/awara-results/airtemp-models.png" alt="Air temperature anomaly model comparison"></a><figcaption><strong>Air temperature</strong><span>3 methods ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/dewpoint-models.png" target="_blank"><img loading="lazy" src="assets/awara-results/dewpoint-models.png" alt="Dew point anomaly model comparison"></a><figcaption><strong>Dew point</strong><span>3 methods ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/lst-models.png" target="_blank"><img loading="lazy" src="assets/awara-results/lst-models.png" alt="LST anomaly model comparison"></a><figcaption><strong>Land surface temperature</strong><span>3 methods ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/olr-models.png" target="_blank"><img loading="lazy" src="assets/awara-results/olr-models.png" alt="OLR anomaly model comparison"></a><figcaption><strong>Outgoing longwave radiation</strong><span>3 methods ↗</span></figcaption></figure>
      <figure class="card featured"><a class="image-shell" href="assets/awara-results/aod-models.png" target="_blank"><img loading="lazy" src="assets/awara-results/aod-models.png" alt="AOD anomaly model comparison"></a><figcaption><strong>Aerosol optical depth</strong><span>3 methods ↗</span></figcaption></figure>
    </div></div></section>

    <section><div class="wrap"><div class="section-head"><div><div class="section-kicker">04 · Event window</div><h2>Sliding-window analysis</h2></div><p>A fixed baseline and the 10–24 September pre-earthquake window clarify which departures occurred closest to the Mw 7.7 event.</p></div><div class="gallery">
      <figure class="card"><a class="image-shell" href="assets/awara-results/airtemp-window.png" target="_blank"><img loading="lazy" src="assets/awara-results/airtemp-window.png" alt="Air temperature sliding-window anomaly analysis"></a><figcaption><strong>Air temperature window</strong><span>Pre-seismic ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/dewpoint-window.png" target="_blank"><img loading="lazy" src="assets/awara-results/dewpoint-window.png" alt="Dew point sliding-window anomaly analysis"></a><figcaption><strong>Dew point window</strong><span>Pre-seismic ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/lst-window.png" target="_blank"><img loading="lazy" src="assets/awara-results/lst-window.png" alt="LST sliding-window anomaly analysis"></a><figcaption><strong>LST window</strong><span>Pre-seismic ↗</span></figcaption></figure>
      <figure class="card"><a class="image-shell" href="assets/awara-results/olr-window.png" target="_blank"><img loading="lazy" src="assets/awara-results/olr-window.png" alt="OLR sliding-window anomaly analysis"></a><figcaption><strong>OLR window</strong><span>Pre-seismic ↗</span></figcaption></figure>
      <figure class="card featured"><a class="image-shell" href="assets/awara-results/aod-window.png" target="_blank"><img loading="lazy" src="assets/awara-results/aod-window.png" alt="AOD sliding-window anomaly analysis"></a><figcaption><strong>AOD window</strong><span>Pre-seismic ↗</span></figcaption></figure>
    </div></div></section>

    <section><div class="wrap"><div class="section-head"><div><div class="section-kicker">05 · Synthesis</div><h2>The complete signal</h2></div><p>The combined figure aligns all five indicators on a shared timeline, making the pre-seismic window and cross-variable behaviour legible in one research plate.</p></div><div class="gallery"><figure class="card featured"><a class="image-shell" href="assets/awara-results/combined-precursors.png" target="_blank"><img loading="lazy" src="assets/awara-results/combined-precursors.png" alt="Combined multi-precursor analysis for the Awaran earthquake"></a><figcaption><strong>Multi-precursor synthesis</strong><span>Complete analysis ↗</span></figcaption></figure></div></div></section>
  </main>
  <footer><div class="wrap footer-inner"><span>Awaran earthquake research archive · Muddasir Ali</span><a href="muddasir-portfolio-fused.html#projects">Return to selected projects ↑</a></div></footer>
  <script>const cards=document.querySelectorAll('.card');if(!matchMedia('(prefers-reduced-motion: reduce)').matches){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target)}}),{threshold:.08});cards.forEach(card=>observer.observe(card))}else cards.forEach(card=>card.classList.add('visible'));</script>

</body>
</html>
