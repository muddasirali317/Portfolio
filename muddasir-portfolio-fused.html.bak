          <div class="signal-ring r3"></div><div class="signal-ring r2"></div><div class="signal-ring r1"></div><div class="signal-sweep"></div><div class="signal-core"></div>
          <span class="signal-label l1">Spatial signal</span><span class="signal-label l2">Open channel</span><span class="signal-label l3">Peshawar · PK</span>
