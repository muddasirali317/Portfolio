  <footer>Muddasir Ali · GIS Analyst · Built with care</footer>

<script>
(function(){
  "use strict";

  var chapters = [
    {id:'hero',accent:'#ff6b4a'},
    {id:'about',accent:'#ff4b26'},
    {id:'experience',accent:'#ff4b26'},
    {id:'projects',accent:'#ff4b26'},
    {id:'skills',accent:'#ff6b4a'},
    {id:'contact',accent:'#ff4b26'}
  ];
  var progressLine = document.getElementById('progress-line');
  var navLinks = document.querySelectorAll('#site-nav .nav-links a');
  progressLine.style.background = chapters[0].accent;

  var sectionObserver = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(!entry.isIntersecting) return;
      var id = entry.target.getAttribute('data-chapter');
      var ch = chapters.find(function(c){return c.id===id;});
      if(ch){
        progressLine.style.background = ch.accent;
        navLinks.forEach(function(a){
          a.classList.toggle('active', a.getAttribute('href') === '#'+entry.target.id);
        });
      }
    });
  }, {threshold:.35});
  document.querySelectorAll('section[data-chapter]').forEach(function(s){ sectionObserver.observe(s); });

  // fade-up reveal with per-container stagger
  document.querySelectorAll('.container').forEach(function(container){
    var groups = [
      container.querySelectorAll(':scope > .fade-up'),
    ];
  });
  var revealObserver = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(!entry.isIntersecting) return;
      entry.target.classList.add('visible');
      revealObserver.unobserve(entry.target);
    });
  }, {threshold:.1, rootMargin:'0px 0px -40px 0px'});

  document.querySelectorAll('.fade-up').forEach(function(el, i){
    if(!el.style.transitionDelay){
      var localIndex = 0;
      var parent = el.parentElement;
      var siblings = parent ? Array.prototype.filter.call(parent.children, function(c){return c.classList.contains('fade-up');}) : [el];
      localIndex = siblings.indexOf(el);
      el.style.transitionDelay = Math.min(localIndex * 0.1, 0.5) + 's';
    }
    revealObserver.observe(el);
  });
  document.querySelectorAll('.hero-name').forEach(function(el){ revealObserver.observe(el); });

  // stagger reveal for grid children (timeline items, projects, skill groups)
  [document.querySelectorAll('.tl-item'), document.querySelectorAll('.project'), document.querySelectorAll('.skill-group')].forEach(function(list){
    list.forEach(function(el, i){
      el.style.opacity = '0';
      el.style.transform = 'translateY(24px)';
      el.style.transition = 'opacity .7s var(--ease), transform .7s var(--ease)';
      el.style.transitionDelay = Math.min(i*0.08,0.4)+'s';
      var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(entry.isIntersecting){
            entry.target.style.opacity='1';
            entry.target.style.transform='translateY(0)';
            obs.unobserve(entry.target);
          }
        });
      }, {threshold:.15});
      obs.observe(el);
    });
  });

  // nav smooth scroll
  navLinks.forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault();
      var target = document.querySelector(a.getAttribute('href'));
      if(target) target.scrollIntoView({behavior:'smooth', block:'start'});
    });
  });

  // nav hide on scroll down, progress bar width
  var lastY = 0;
  var nav = document.getElementById('site-nav');
  window.addEventListener('scroll', function(){
    var y = window.scrollY;
    nav.classList.toggle('hidden', y > lastY && y > 100);
    lastY = y;
    var docH = document.documentElement.scrollHeight - window.innerHeight;
    var pct = docH > 0 ? y / docH : 0;
    progressLine.style.transform = 'scaleX(' + Math.min(pct,1) + ')';
  }, {passive:true});

  // count-up stats
  var counters = document.querySelectorAll('.h-num[data-count]');
  var countObserver = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(!entry.isIntersecting) return;
      var el = entry.target;
      var target = parseInt(el.getAttribute('data-count'), 10);
      var suffix = el.getAttribute('data-suffix') || '';
      var start = null;
      var duration = 1400;
      function step(ts){
        if(!start) start = ts;
        var progress = Math.min((ts - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var val = Math.floor(eased * target);
        el.textContent = val.toLocaleString() + suffix;
        if(progress < 1) requestAnimationFrame(step);
        else el.textContent = target.toLocaleString() + suffix;
      }
      requestAnimationFrame(step);
      countObserver.unobserve(el);
    });
  }, {threshold:.4});
  counters.forEach(function(c){ countObserver.observe(c); });
  document.querySelectorAll('.h-num[data-static]').forEach(function(el){
    el.textContent = el.getAttribute('data-static');
  });

  // hero role typing effect
  var roles = ['GIS Analyst','Zoning & Parcel Data Specialist','Remote Sensing Analyst','Geospatial Data Scientist'];
  var roleEl = document.getElementById('role-type');
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduceMotion){
    roleEl.textContent = roles[0] + ' · Open to Remote Opportunities';
  } else {
    var ri = 0, ci = 0, deleting = false;
    function typeLoop(){
      var word = roles[ri];
      if(!deleting){
        ci++;
        roleEl.innerHTML = word.slice(0,ci) + '<span class="type-cursor"></span>';
        if(ci === word.length){ deleting = true; setTimeout(typeLoop, 1400); return; }
      } else {
        ci--;
        roleEl.innerHTML = word.slice(0,ci) + '<span class="type-cursor"></span>';
        if(ci === 0){ deleting = false; ri = (ri+1) % roles.length; }
      }
      setTimeout(typeLoop, deleting ? 35 : 65);
    }
    typeLoop();
  }

  // timeline draw-on-scroll fill
  var tlFill = document.getElementById('tl-fill');
  var tlTrack = document.querySelector('.timeline');
  if(tlFill && tlTrack){
    window.addEventListener('scroll', function(){
      var rect = tlTrack.getBoundingClientRect();
      var vh = window.innerHeight;
      var total = rect.height;
      var visible = Math.min(Math.max(vh*0.75 - rect.top, 0), total);
      tlFill.style.height = visible + 'px';
    }, {passive:true});
  }

  // highlight the experience card currently crossing the reading zone
  var timelineItems = document.querySelectorAll('.tl-item');
  var timelineFocusObserver = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(!entry.isIntersecting) return;
      timelineItems.forEach(function(item){ item.classList.remove('active'); });
      entry.target.classList.add('active');
    });
  }, {threshold:.42, rootMargin:'-18% 0px -30% 0px'});
  timelineItems.forEach(function(item){ timelineFocusObserver.observe(item); });

  // purposeful section, skill-fill and QA status activation
  if(!reduceMotion){
    var capabilityObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(!entry.isIntersecting) return;
        if(entry.target.classList.contains('skill-group')) entry.target.classList.add('skill-live');
        if(entry.target.classList.contains('custom-tool')) entry.target.classList.add('tool-live');
        if(entry.target.classList.contains('section')) entry.target.classList.add('section-live');
        capabilityObserver.unobserve(entry.target);
      });
    }, {threshold:.22, rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.skill-group,.custom-tool,.section').forEach(function(el){ capabilityObserver.observe(el); });
  } else {
    document.querySelectorAll('.skill-group').forEach(function(el){ el.classList.add('skill-live'); });
    document.querySelectorAll('.section').forEach(function(el){ el.classList.add('section-live'); });
  }

  // fine-pointer only interactions
  var fine = window.matchMedia('(pointer: fine)').matches;
  if(fine && !reduceMotion){
    document.body.classList.add('cursor-ready');
    var dot = document.getElementById('cur-dot');
    var ring = document.getElementById('cur-ring');
    var mx=window.innerWidth/2,my=window.innerHeight/2, dx=mx,dy=my,rx=mx,ry=my;
    window.addEventListener('mousemove', function(e){
      mx = e.clientX; my = e.clientY;
    });
    function ringLoop(){
      dx += (mx-dx)*0.28; dy += (my-dy)*0.28;
      rx += (mx-rx)*0.105; ry += (my-ry)*0.105;
      dot.style.left = dx+'px'; dot.style.top = dy+'px';
      ring.style.left = rx+'px'; ring.style.top = ry+'px';
      requestAnimationFrame(ringLoop);
    }
    ringLoop();
    document.querySelectorAll('a, .project, .skill-group, .custom-tool, .about-portrait, .h-stat').forEach(function(el){
      el.addEventListener('mouseenter', function(){ document.body.classList.add('cursor-hover'); });
      el.addEventListener('mouseleave', function(){ document.body.classList.remove('cursor-hover'); });
    });

    // magnetic buttons
    document.querySelectorAll('.cta-link').forEach(function(btn){
      btn.addEventListener('mousemove', function(e){
        var r = btn.getBoundingClientRect();
        var relX = e.clientX - r.left - r.width/2;
        var relY = e.clientY - r.top - r.height/2;
        btn.style.transform = 'translate(' + (relX*0.25) + 'px,' + (relY*0.35) + 'px)';
      });
      btn.addEventListener('mouseleave', function(){ btn.style.transform = 'translate(0,0)'; });
    });

    // tilt cards
    document.querySelectorAll('[data-tilt]').forEach(function(card){
      var inner = card.querySelector('.project-inner');
      var visual = card.querySelector('.project-visual');
      card.addEventListener('mousemove', function(e){
        var r = card.getBoundingClientRect();
        var px = (e.clientX - r.left)/r.width - 0.5;
        var py = (e.clientY - r.top)/r.height - 0.5;
        inner.style.transform = 'rotateY(' + (px*8) + 'deg) rotateX(' + (-py*8) + 'deg) translateZ(6px)';
        if(visual) visual.style.transform = 'translate(' + (-px*10) + 'px,' + (-py*8) + 'px) scale(1.035)';
      });
      card.addEventListener('mouseleave', function(){ inner.style.transform = 'rotateY(0) rotateX(0)'; if(visual) visual.style.transform = ''; });
    });

    // hero coordinate reticle
    var heroSection = document.getElementById('top');
    var reticle = document.getElementById('reticle');
    var latVal = document.getElementById('lat-val');
    var lngVal = document.getElementById('lng-val');
    heroSection.addEventListener('mousemove', function(e){
      var r = heroSection.getBoundingClientRect();
      reticle.style.left = (e.clientX - r.left) + 'px';
      reticle.style.top = (e.clientY - r.top) + 'px';
      var fx = (e.clientX - r.left)/r.width - 0.5;
      var fy = (e.clientY - r.top)/r.height - 0.5;
      latVal.textContent = (34.0151 - fy*0.06).toFixed(4);
      lngVal.textContent = (71.5249 + fx*0.06).toFixed(4);
    });
  }
})();
</script>
<script>
(function(){
  "use strict";
  var chars=[];
  document.querySelectorAll('.kinetic-line').forEach(function(line,lineIndex){
    line.getAttribute('data-text').split('').forEach(function(letter,index){
      var span=document.createElement('span');
      span.className='kinetic-char'; span.textContent=letter;
      span.style.animationDelay=(.28+lineIndex*.22+index*.045)+'s';
      line.appendChild(span);
      chars.push({el:span,x:0,y:0,s:1,r:0,tx:0,ty:0,ts:1,tr:0});
    });
  });

  var mx=-9999,my=-9999,reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.addEventListener('mousemove',function(e){
    mx=e.clientX;my=e.clientY;
    var coord=document.getElementById('cursorCoord');
    if(coord){
      var lat=(34.0151+(0.5-e.clientY/window.innerHeight)*.08).toFixed(4);
      var lon=(71.5249+(e.clientX/window.innerWidth-.5)*.08).toFixed(4);
      coord.textContent='CURSOR  →  N '+lat+'°  E '+lon+'°';
    }
  },{passive:true});

  document.querySelectorAll('.project').forEach(function(card){
    card.addEventListener('mousemove',function(e){
      var r=card.getBoundingClientRect();
      card.style.setProperty('--mx',((e.clientX-r.left)/r.width*100).toFixed(1)+'%');
      card.style.setProperty('--my',((e.clientY-r.top)/r.height*100).toFixed(1)+'%');
    });
  });

  var contactTime=document.getElementById('contact-time');
  function updateContactTime(){
    if(!contactTime) return;
    contactTime.textContent='PKT · '+new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Karachi',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date());
  }
  updateContactTime();setInterval(updateContactTime,30000);
  var contactSection=document.getElementById('contact');
  var contactVisual=document.querySelector('.contact-visual');
  if(contactSection && contactVisual && !reduce){
    contactSection.addEventListener('mousemove',function(e){
      var r=contactSection.getBoundingClientRect();
      var px=(e.clientX-r.left)/r.width-.5,py=(e.clientY-r.top)/r.height-.5;
      contactVisual.style.translate=(px*18).toFixed(1)+'px '+(py*18).toFixed(1)+'px';
    });
    contactSection.addEventListener('mouseleave',function(){contactVisual.style.translate='0 0';});
  }
  var aboutSection=document.getElementById('about'),parcelVisual=document.querySelector('.about-portrait');
  if(aboutSection && parcelVisual && !reduce){
    aboutSection.addEventListener('mousemove',function(e){
      var r=aboutSection.getBoundingClientRect(),px=(e.clientX-r.left)/r.width-.5,py=(e.clientY-r.top)/r.height-.5;
      parcelVisual.style.translate=(px*16).toFixed(1)+'px '+(py*13).toFixed(1)+'px';
    });
    aboutSection.addEventListener('mouseleave',function(){parcelVisual.style.translate='0 0';});
  }

  /* Scroll choreography for the hero name */
  var hero=document.getElementById('top');
  var heroName=document.querySelector('.hero-name');
  var scrollQueued=false;
  function updateHeroScroll(){
    scrollQueued=false;
    if(!hero || !heroName || reduce) return;
    var distance=Math.max(hero.offsetHeight*.92,1);
    var raw=Math.min(Math.max(window.scrollY/distance,0),1);
    var p=raw*raw*(3-2*raw);
    heroName.style.opacity=(1-p*.96).toFixed(3);
    heroName.style.transform='translate3d(0,'+(-p*72).toFixed(1)+'px,0) scale('+(1-p*.09).toFixed(3)+')';
    heroName.style.filter='blur('+(p*4.5).toFixed(2)+'px)';
  }
  window.addEventListener('scroll',function(){
    if(!scrollQueued){scrollQueued=true;requestAnimationFrame(updateHeroScroll);}
  },{passive:true});
  updateHeroScroll();

  function animateLetters(){
    chars.forEach(function(c){
      var b=c.el.getBoundingClientRect(),dx=mx-(b.left+b.width/2),dy=my-(b.top+b.height/2),d=Math.sqrt(dx*dx+dy*dy),f=d<145?Math.pow(1-d/145,1.7):0;
      if(f){var a=Math.atan2(dy,dx);c.tx=-Math.cos(a)*f*13;c.ty=-Math.sin(a)*f*13-f*22;c.ts=1+f*.16;c.tr=f*6*(dx>0?1:-1)}else{c.tx=0;c.ty=0;c.ts=1;c.tr=0}
      c.x+=(c.tx-c.x)*.16;c.y+=(c.ty-c.y)*.16;c.s+=(c.ts-c.s)*.16;c.r+=(c.tr-c.r)*.16;
      c.el.style.transform='translate('+c.x.toFixed(2)+'px,'+c.y.toFixed(2)+'px) scale('+c.s.toFixed(3)+') rotate('+c.r.toFixed(2)+'deg)';
    });
  }

  if(!reduce){setTimeout(function letterTick(){animateLetters();requestAnimationFrame(letterTick)},1500);}
  if(!window.THREE || reduce) return;
  var canvas=document.getElementById('hex-canvas'),renderer=new THREE.WebGLRenderer({canvas:canvas,alpha:true,antialias:true});
  renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
  var scene=new THREE.Scene(),camera=new THREE.PerspectiveCamera(48,1,.1,100);camera.position.z=8;
  scene.add(new THREE.AmbientLight(0x661e14,.7));
  var light=new THREE.PointLight(0xff4b26,1.4,18);light.position.set(-3,2,5);scene.add(light);
  var gold=new THREE.DirectionalLight(0xff6b4a,.85);gold.position.set(4,6,4);scene.add(gold);
  var group=new THREE.Group();
  function prism(r,h){return new THREE.CylinderGeometry(r,r,h,6,1)}
  function wire(r,h,color,opacity){var g=prism(r,h),m=new THREE.LineBasicMaterial({color:color,transparent:true,opacity:opacity});return new THREE.LineSegments(new THREE.EdgesGeometry(g),m)}
  var coreGeo=prism(1.45,.42),core=new THREE.Mesh(coreGeo,new THREE.MeshPhongMaterial({color:0x661e14,transparent:true,opacity:.14,side:THREE.DoubleSide,shininess:70}));
  var coreWire=wire(1.45,.42,0xff4b26,.9),mid=wire(2.45,.16,0x661e14,.5),outer=wire(3.45,.08,0x661e14,.2),vertical=wire(2.05,.1,0xff6b4a,.25),diagonal=wire(2.9,.1,0xff4b26,.15);
  mid.rotation.set(.28,Math.PI/6,0);outer.rotation.set(.46,Math.PI/12,0);vertical.rotation.set(0,.35,Math.PI/2);diagonal.rotation.set(Math.PI/2,0,Math.PI/6);
  group.add(core,coreWire,mid,outer,vertical,diagonal);group.position.set(3,.15,0);group.rotation.x=.72;scene.add(group);
  var px=0,py=0,tpx=0,tpy=0,t=0;
  document.addEventListener('mousemove',function(e){tpx=(e.clientX/window.innerWidth-.5)*.5;tpy=(e.clientY/window.innerHeight-.5)*.3},{passive:true});
  function resize(){var r=document.getElementById('top').getBoundingClientRect();renderer.setSize(r.width,r.height,false);camera.aspect=r.width/r.height;camera.updateProjectionMatrix();group.position.x=innerWidth<900?1.7:3}
  resize();window.addEventListener('resize',resize);
  function tick(){requestAnimationFrame(tick);t+=.007;px+=(tpx-px)*.05;py+=(tpy-py)*.05;group.rotation.y=t*.34+px;group.rotation.x=.72+py;core.rotation.y=-t*.55;coreWire.rotation.y=-t*.55;vertical.rotation.y=t*.28+.35;outer.material.opacity=.13+Math.sin(t*.9)*.07;light.position.x=Math.cos(t*.65)*3.5;light.position.z=Math.sin(t*.65)*3.5+2;renderer.render(scene,camera)}
  tick();
})();
</script>
</body>
</html>
